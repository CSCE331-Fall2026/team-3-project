CREATE TABLE Inventory (InventoryID INT PRIMARY KEY,ItemName VARCHAR(100) NOT NULL,Unit VARCHAR(20) NOT NULL,Minimum_Threshold DECIMAL(10,2) NOT NULL,Quantity DECIMAL(10,2) NOT NULL,ShelfLifeDays INT NOT NULL);

CREATE TABLE InventoryItem (ShipmentID INT PRIMARY KEY,InventoryID INT NOT NULL,WholesalePrice DECIMAL(10,2) NOT NULL,Quantity DECIMAL(10,2) NOT NULL,ReceivedDate DATE NOT NULL,ExpirationDate DATE NOT NULL,FOREIGN KEY (InventoryID) REFERENCES Inventory(InventoryID));

CREATE TABLE MenuItem (MenuItemID INT PRIMARY KEY,MenuItemName VARCHAR(150) NOT NULL,Price DECIMAL(10,2) NOT NULL);

CREATE TABLE MenuItemInventory (MenuItemID INT NOT NULL,InventoryID INT NOT NULL,QuantityRequired DECIMAL(10,3) NOT NULL,PRIMARY KEY (MenuItemID, InventoryID),FOREIGN KEY (MenuItemID) REFERENCES MenuItem(MenuItemID),FOREIGN KEY (InventoryID) REFERENCES Inventory(InventoryID));

CREATE TABLE Orders (OrderID INT PRIMARY KEY,OrderDate DATE NOT NULL,OrderTime TIME NOT NULL,Total DECIMAL(10,2) NOT NULL);

CREATE TABLE OrderItem (OrderItemID INT PRIMARY KEY,OrderID INT NOT NULL,MenuItemID INT NOT NULL,Qty INT NOT NULL,FOREIGN KEY (OrderID) REFERENCES Orders(OrderID),FOREIGN KEY (MenuItemID) REFERENCES MenuItem(MenuItemID));

